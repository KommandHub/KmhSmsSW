{% block kmh_sms_credential_check %}
<div class="kmh-sms-credential-check">
    <div class="kmh-sms-credential-check__action">
        <mt-button
            variant="secondary"
            size="small"
            :is-loading="isChecking"
            :disabled="isChecking"
            @click="onCheck"
        >
            {{ $t('kmh-sms.credentialCheck.button') }}
        </mt-button>

        <span class="kmh-sms-credential-check__hint">
            {{ $t('kmh-sms.credentialCheck.hint') }}
        </span>
    </div>

    <mt-banner
        v-if="result"
        class="kmh-sms-credential-check__result"
        :variant="result.valid ? 'positive' : 'critical'"
    >
        {{ result.message }}
        <template v-if="result.detail">
            <br>
            <span class="kmh-sms-credential-check__detail">{{ result.detail }}</span>
        </template>
    </mt-banner>
</div>
{% endblock %}
